// Student Score Record System — PostgreSQL schema.
// Design reference: docs/database-design.md.
//
// Constraints Prisma cannot express (CHECK constraints, immutability triggers) live in raw SQL
// inside the migrations. Prisma does not manage them, so they never appear as drift.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm]
}

// ---------------------------------------------------------------------------------------------
// Users, sessions
// ---------------------------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STUDENT
}

enum UserStatus {
  /// Provisioned by sync; no credentials issued yet. Cannot log in.
  PENDING
  ACTIVE
  DISABLED
}

enum SessionRevokeReason {
  LOGOUT
  REUSE_DETECTED
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_DISABLED
  ADMIN
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  /// Admins: chosen login name. Students: normalized student code.
  username           String     @unique @db.Citext
  role               UserRole
  status             UserStatus @default(ACTIVE)
  /// Argon2id PHC string.
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordExpiresAt  DateTime?  @map("password_expires_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  displayName        String?    @map("display_name")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  student              Student?
  sessions             AuthSession[]
  auditLogs            AuditLog[]
  sourcesCreated       GoogleSheetSource[]
  syncJobsRequested    SyncJob[]
  schemesCreated       GradingScheme[]           @relation("SchemeCreatedBy")
  schemesPublished     GradingScheme[]           @relation("SchemePublishedBy")
  scoresUpdated        AssessmentScore[]
  scoreRevisions       AssessmentScoreRevision[]
  tabMappingsConfirmed SheetTabMapping[]
  previewsRun          SheetPreview[]            @relation("PreviewRunBy")
  previewsConfirmed    SheetPreview[]            @relation("PreviewConfirmedBy")
  gradeScalesConfirmed GradeScale[]
  termIssuesResolved   StudentTermIssue[]

  @@index([role, status])
  @@map("users")
}

model AuthSession {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute lifetime; refresh never extends it.
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason SessionRevokeReason? @map("revoke_reason")
  ip           String?
  userAgent    String?              @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId], map: "auth_sessions_active_user_idx", where: raw("revoked_at IS NULL"))
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 hex of a 256-bit random token.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when rotated. Presenting a used token revokes the whole session.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------------------------

enum GenerationStatus {
  ACTIVE
  ARCHIVED
}

model Generation {
  id           String           @id @default(uuid(7)) @db.Uuid
  /// Must equal the spreadsheet `_meta.generation_code`.
  code         String           @unique @db.Citext
  name         String
  startDate    DateTime         @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  status       GenerationStatus @default(ACTIVE)
  /// Incremented to invalidate cached results for this generation.
  cacheVersion Int              @default(1) @map("cache_version")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  terms      Term[]
  offerings  CourseOffering[]
  sources    GoogleSheetSource[]
  students   Student[]
  syncJobs   SyncJob[]
  gradeScale GradeScale?

  @@map("generations")
}

model Term {
  id           String    @id @default(uuid(7)) @db.Uuid
  generationId String    @map("generation_id") @db.Uuid
  number       Int       @db.SmallInt
  name         String
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  generation    Generation          @relation(fields: [generationId], references: [id])
  offerings     CourseOffering[]
  /// Term workbooks: one spreadsheet per term.
  sources       GoogleSheetSource[]
  syncJobs      SyncJob[]
  programs      TermProgram[]
  studentTerms  StudentTerm[]
  studentIssues StudentTermIssue[]

  @@unique([generationId, number])
  /// Target of the composite FK that keeps course_offerings.generation_id consistent.
  @@unique([id, generationId])
  @@map("terms")
}

/// Course catalog. Criteria and grading belong to offerings, not to catalog courses.
model Course {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.Citext
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  offerings CourseOffering[]
  aliases   CourseAlias[]

  @@map("courses")
}

/// Alternative names of a catalog course, used to match term-workbook tab titles (ENG, ENGLISH).
model CourseAlias {
  /// Normalized: trimmed, inner whitespace collapsed; compared case-insensitively.
  alias     String   @id @db.Citext
  courseId  String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_aliases")
}

/// Study program: GENERAL (Term 1), WEP (Web Programming), SNAC (System Network
/// Administrators and Cybersecurity). Which programs a term has is `term_programs`.
model Program {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.Citext
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  students        Student[]
  offerings       OfferingProgram[]
  aliases         ProgramAlias[]
  terms           TermProgram[]
  tabAudiences    SheetTabMapping[]
  enrollmentTerms StudentTerm[]

  @@map("programs")
}

/// Other names a sheet may use for a program, e.g. SNA for SNAC. Compared case-insensitively.
model ProgramAlias {
  alias     String   @id @db.Citext
  programId String   @map("program_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_aliases")
}

/// The programs taught in a term (configuration). Default: Term 1 GENERAL, Terms 2–5 WEP and SNAC.
model TermProgram {
  termId    String   @map("term_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  term         Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  program      Program       @relation(fields: [programId], references: [id])
  classes      TermClass[]
  studentTerms StudentTerm[]

  @@id([termId, programId])
  @@index([programId])
  @@map("term_programs")
}

/// A class of one program in one term (configuration, editable by admins).
model TermClass {
  id        String   @id @default(uuid(7)) @db.Uuid
  termId    String   @map("term_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  /// Trimmed. Unique within the term across programs, so a class names its program.
  name      String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  termProgram  TermProgram   @relation(fields: [termId, programId], references: [termId, programId], onDelete: Cascade)
  studentTerms StudentTerm[]

  @@unique([termId, name])
  /// Target of the composite FK keeping a student term's class in its own term and program.
  @@unique([id, termId, programId])
  @@index([termId, programId])
  @@map("term_classes")
}

/// Programs an offering is meant for. No rows = shared by every program (English, PL).
model OfferingProgram {
  offeringId String @map("offering_id") @db.Uuid
  programId  String @map("program_id") @db.Uuid

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  program  Program        @relation(fields: [programId], references: [id])

  @@id([offeringId, programId])
  @@index([programId])
  @@map("offering_programs")
}

enum ResultsVisibility {
  HIDDEN
  VISIBLE
}

enum OfferingStatus {
  ACTIVE
  ARCHIVED
}

/// A catalog course taught in one term of one generation.
model CourseOffering {
  id                   String            @id @default(uuid(7)) @db.Uuid
  termId               String            @map("term_id") @db.Uuid
  generationId         String            @map("generation_id") @db.Uuid
  courseId             String            @map("course_id") @db.Uuid
  /// `course_key` from the spreadsheet; stable identifier within the generation.
  externalKey          String            @map("external_key") @db.Citext
  title                String
  credits              Decimal           @default(1) @db.Decimal(4, 1)
  visibility           ResultsVisibility @default(HIDDEN)
  /// Once an admin sets visibility, sync no longer overwrites it.
  visibilityOverridden Boolean           @default(false) @map("visibility_overridden")
  /// Owning spreadsheet source; NULL when created manually.
  sourceId             String?           @map("source_id") @db.Uuid
  sheetTab             String?           @map("sheet_tab")
  status               OfferingStatus    @default(ACTIVE)
  /// Set when its tab left the term's sheet and an admin confirmed the removal. Data is kept.
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  term        Term                  @relation(fields: [termId, generationId], references: [id, generationId])
  generation  Generation            @relation(fields: [generationId], references: [id])
  course      Course                @relation(fields: [courseId], references: [id])
  source      GoogleSheetSource?    @relation(fields: [sourceId], references: [id])
  criteria    AssessmentCriterion[]
  schemes     GradingScheme[]
  enrollments Enrollment[]
  programs    OfferingProgram[]
  tabMappings SheetTabMapping[]

  @@unique([termId, courseId])
  @@unique([generationId, externalKey])
  @@index([generationId, visibility])
  @@index([sourceId])
  @@map("course_offerings")
}

// ---------------------------------------------------------------------------------------------
// Google Sheets sources
// ---------------------------------------------------------------------------------------------

enum SourceStatus {
  /// Feeds the term's scores.
  ACTIVE
  /// Connected to replace the active sheet; becomes ACTIVE only when its sync completes.
  PENDING
  /// Not in use. Also the history of sheets a term has used.
  DISABLED
}

model GoogleSheetSource {
  id               String       @id @default(uuid(7)) @db.Uuid
  generationId     String       @map("generation_id") @db.Uuid
  /// One spreadsheet file can belong to only one generation.
  spreadsheetId    String       @unique @map("spreadsheet_id")
  label            String
  spreadsheetTitle String?      @map("spreadsheet_title")
  status           SourceStatus @default(ACTIVE)
  /// One workbook per term, one tab per subject.
  termId           String       @map("term_id") @db.Uuid
  /// Tab holding the master roster (profiles only, never scores).
  rosterTab        String       @default("ALL") @map("roster_tab")
  /// Extra tabs to skip. Tabs starting with "_" are always skipped.
  ignoredTabs      String[]     @default([]) @map("ignored_tabs")
  lastSyncedAt     DateTime?    @map("last_synced_at") @db.Timestamptz(3)
  lastSyncJobId    String?      @map("last_sync_job_id") @db.Uuid
  createdById      String       @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  generation   Generation        @relation(fields: [generationId], references: [id])
  term         Term              @relation(fields: [termId, generationId], references: [id, generationId], onDelete: Restrict)
  createdBy    User              @relation(fields: [createdById], references: [id])
  offerings    CourseOffering[]
  students     Student[]
  syncJobs     SyncJob[]
  tabMappings  SheetTabMapping[]
  previews     SheetPreview[]
  studentTerms StudentTerm[]

  @@unique([termId], map: "google_sheet_sources_one_active_per_term", where: raw("status = 'ACTIVE'"))
  @@unique([termId], map: "google_sheet_sources_one_pending_per_term", where: raw("status = 'PENDING'"))
  @@index([generationId])
  @@map("google_sheet_sources")
}

enum TabMappingStatus {
  /// Proposed by detection; not used by sync until confirmed.
  DRAFT
  CONFIRMED
  IGNORED
  /// The tab left the sheet and its subject was archived. Sync skips it; detection reopens it.
  REMOVED
}

/// How one subject tab of a term workbook maps to an offering.
model SheetTabMapping {
  id                String           @id @default(uuid(7)) @db.Uuid
  sourceId          String           @map("source_id") @db.Uuid
  tabName           String           @map("tab_name")
  /// Google's numeric sheetId: survives tab renames.
  sheetTabId        Int?             @map("sheet_tab_id")
  /// NULL while DRAFT, when IGNORED, or for a pending sheet's subject that does not exist yet.
  offeringId        String?          @map("offering_id") @db.Uuid
  /// Pending sheets: the confirmed subject name, applied by the sync that promotes the sheet.
  proposedTitle     String?          @map("proposed_title")
  /// Who takes the subject: every program of the term, or one. NULL until confirmed.
  audience          TabAudience?     @map("audience")
  /// audience = PROGRAM only (CHECK in migration).
  audienceProgramId String?          @map("audience_program_id") @db.Uuid
  /// 1-based row holding the leaf column labels.
  headerRow         Int              @map("header_row")
  status            TabMappingStatus @default(DRAFT)
  /// Incremented on every confirmation; recorded by sync jobs.
  version           Int              @default(0)
  /// SHA-256 hex of the normalized header rows; a change means the tab must be re-mapped.
  headerSignature   String           @map("header_signature") @db.Char(64)
  /// SHA-256 hex of the tab values last applied successfully; unchanged tabs are skipped.
  lastContentHash   String?          @map("last_content_hash") @db.Char(64)
  confirmedById     String?          @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  source          GoogleSheetSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  offering        CourseOffering?      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  confirmedBy     User?                @relation(fields: [confirmedById], references: [id])
  audienceProgram Program?             @relation(fields: [audienceProgramId], references: [id], onDelete: Restrict)
  columns         SheetColumnMapping[]

  @@unique([sourceId, tabName])
  /// A subject may be mapped once per sheet; an active and a pending sheet can share it.
  @@unique([sourceId, offeringId])
  @@index([offeringId])
  @@map("sheet_tab_mappings")
}

/// An impact preview of a pending sheet. Only the newest one that is not invalidated can
/// authorize a sync, and only for the exact sheet content and mappings it was run on.
model SheetPreview {
  id              String    @id @default(uuid(7)) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  /// SHA-256 hex of the tabs a sync would read.
  fingerprint     String    @db.Char(64)
  /// { tabMappingId: version } the preview ran with.
  mappingVersions Json      @map("mapping_versions")
  /// Counts, tab problems and missing students shown to the admin.
  summary         Json
  runById         String    @map("run_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedById   String?   @map("confirmed_by") @db.Uuid
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  invalidatedAt   DateTime? @map("invalidated_at") @db.Timestamptz(3)

  source      GoogleSheetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runBy       User              @relation("PreviewRunBy", fields: [runById], references: [id])
  confirmedBy User?             @relation("PreviewConfirmedBy", fields: [confirmedById], references: [id])

  @@index([sourceId, createdAt(sort: Desc)])
  @@map("sheet_previews")
}

/// Who takes a subject tab. SHARED: every program of the term (Term 1: General).
enum TabAudience {
  SHARED
  PROGRAM
}

enum ColumnRole {
  STUDENT_ID
  FIRST_NAME
  LAST_NAME
  FULL_NAME
  GENDER
  CLASS
  /// MAJOR / PROGRAM: cross-checked against ALL, never decides enrollment.
  PROGRAM
  /// A row-number column (#N, #, No, or 1, 2, 3…): never a mark.
  ROW_NUMBER
  CRITERION
  /// The sheet's own total: read for the weight cross-check only.
  REFERENCE_TOTAL
  COMMENT
  IGNORE
}

model SheetColumnMapping {
  id             String     @id @default(uuid(7)) @db.Uuid
  tabMappingId   String     @map("tab_mapping_id") @db.Uuid
  /// 0-based column index (A = 0).
  columnIndex    Int        @map("column_index")
  headerLabel    String?    @map("header_label")
  /// Nearest group label above the header row (e.g. "MIDTERM (30%)").
  groupLabel     String?    @map("group_label")
  role           ColumnRole
  /// role = CRITERION only (CHECK in migration). Set when the mapping is confirmed.
  criterionId    String?    @map("criterion_id") @db.Uuid
  /// Proposed criterion name and weight (DRAFT); the published scheme is authoritative.
  proposedName   String?    @map("proposed_name")
  proposedWeight Decimal?   @map("proposed_weight") @db.Decimal(6, 3)
  /// Pending sheets: the criterion key the promoting sync uses.
  proposedKey    String?    @map("proposed_key")

  tabMapping SheetTabMapping      @relation(fields: [tabMappingId], references: [id], onDelete: Cascade)
  criterion  AssessmentCriterion? @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([tabMappingId, columnIndex])
  @@unique([tabMappingId, criterionId])
  @@index([criterionId])
  @@map("sheet_column_mappings")
}

// ---------------------------------------------------------------------------------------------
// Students & enrollment
// ---------------------------------------------------------------------------------------------

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

model Student {
  id                String   @id @default(uuid(7)) @db.Uuid
  /// Business student ID, normalized to upper case (see @ssrs/shared normalizeStudentId).
  studentCode       String   @unique @map("student_code")
  userId            String   @unique @map("user_id") @db.Uuid
  generationId      String   @map("generation_id") @db.Uuid
  fullName          String   @map("full_name")
  /// Term workbooks split names; NULL for students imported from the v1 template.
  firstName         String?  @map("first_name")
  lastName          String?  @map("last_name")
  gender            Gender   @default(UNSPECIFIED)
  /// The latest term's class: student_terms of the highest term number. Kept in step by sync.
  className         String?  @map("class_name")
  /// The latest term's program, kept in step with student_terms like `className`.
  programId         String?  @map("program_id") @db.Uuid
  /// Roster source that last updated the profile.
  sourceId          String?  @map("source_id") @db.Uuid
  lastSeenSyncJobId String?  @map("last_seen_sync_job_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id])
  generation  Generation         @relation(fields: [generationId], references: [id])
  source      GoogleSheetSource? @relation(fields: [sourceId], references: [id])
  program     Program?           @relation(fields: [programId], references: [id])
  enrollments Enrollment[]
  terms       StudentTerm[]
  termIssues  StudentTermIssue[]

  /// Target of the composite FK keeping a student term in the student's generation.
  @@unique([id, generationId])
  @@index([generationId, className])
  @@index([generationId, programId, className])
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "students_full_name_trgm_idx", type: Gin)
  @@map("students")
}

enum EnrollmentStatus {
  ENROLLED
  WITHDRAWN
}

/// Why an enrollment was withdrawn by the system rather than by the sheet.
enum EnrollmentEndReason {
  /// An admin approved a program switch and the new program does not take this subject.
  PROGRAM_SWITCH
}

/// Where a student term's program came from.
enum ProgramSource {
  /// The class in the roster tab, mapped through the term's class list.
  SHEET
  /// An admin assignment or override. Sync never changes it.
  ADMIN
}

/// A student's enrollment in one term: program and class. One per student per term.
model StudentTerm {
  id                String        @id @default(uuid(7)) @db.Uuid
  studentId         String        @map("student_id") @db.Uuid
  termId            String        @map("term_id") @db.Uuid
  generationId      String        @map("generation_id") @db.Uuid
  programId         String        @map("program_id") @db.Uuid
  classId           String        @map("class_id") @db.Uuid
  programSource     ProgramSource @default(SHEET) @map("program_source")
  /// The sheet that last set it; NULL when set by an admin or the backfill could not tell.
  sourceId          String?       @map("source_id") @db.Uuid
  lastSeenSyncJobId String?       @map("last_seen_sync_job_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     Student            @relation(fields: [studentId, generationId], references: [id, generationId])
  term        Term               @relation(fields: [termId], references: [id])
  termProgram TermProgram        @relation(fields: [termId, programId], references: [termId, programId])
  class       TermClass          @relation(fields: [classId, termId, programId], references: [id, termId, programId])
  program     Program            @relation(fields: [programId], references: [id])
  source      GoogleSheetSource? @relation(fields: [sourceId], references: [id])

  @@unique([studentId, termId])
  @@index([termId, programId, classId])
  @@index([classId])
  @@map("student_terms")
}

enum StudentTermIssueKind {
  /// No program could be decided: the student's program-specific rows are skipped.
  UNDETERMINED_PROGRAM
  /// The class and a cross-check (CLASS 2, MAJOR, program-only tabs) disagree.
  PROGRAM_CONFLICT
  /// A different program within the same term: waits for an admin.
  PROGRAM_SWITCH
  /// A class that is not in the term's class list.
  UNKNOWN_CLASS
  /// The ID appears more than once in the roster tab: every copy is rejected.
  DUPLICATE_IN_ROSTER
}

/// A student-and-term problem an admin must look at. Rows are kept after they are resolved.
model StudentTermIssue {
  id           String               @id @default(uuid(7)) @db.Uuid
  termId       String               @map("term_id") @db.Uuid
  /// NULL when the ID belongs to no student yet (a duplicate in the roster of a new student).
  studentId    String?              @map("student_id") @db.Uuid
  studentCode  String               @map("student_code")
  kind         StudentTermIssueKind
  /// IDs, class and program codes only. Never names.
  detail       Json                 @default("{}")
  syncJobId    String?              @map("sync_job_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt   DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedById String?              @map("resolved_by") @db.Uuid
  /// e.g. APPROVED, REJECTED, REVERSED, FIXED_IN_SHEET.
  resolution   String?

  term       Term     @relation(fields: [termId], references: [id])
  student    Student? @relation(fields: [studentId], references: [id])
  resolvedBy User?    @relation(fields: [resolvedById], references: [id])

  @@unique([termId, studentCode, kind], map: "student_term_issues_one_open", where: raw("resolved_at IS NULL"))
  @@index([termId, resolvedAt])
  @@index([studentId])
  @@map("student_term_issues")
}

model Enrollment {
  id                String               @id @default(uuid(7)) @db.Uuid
  studentId         String               @map("student_id") @db.Uuid
  offeringId        String               @map("offering_id") @db.Uuid
  status            EnrollmentStatus     @default(ENROLLED)
  /// False when the student's row disappeared from the source sheet (never auto-deleted).
  presentInSource   Boolean              @default(true) @map("present_in_source")
  /// Set with status WITHDRAWN when the system ended it (CHECK in migration).
  endedReason       EnrollmentEndReason? @map("ended_reason")
  /// Teacher's COMMENTS cell; shown to the student once the offering is visible.
  teacherComment    String?              @map("teacher_comment")
  /// The sheet's own TOTAL cell, kept only to cross-check weights.
  sheetTotal        Decimal?             @map("sheet_total") @db.Decimal(8, 3)
  lastSeenSyncJobId String?              @map("last_seen_sync_job_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  student  Student           @relation(fields: [studentId], references: [id])
  offering CourseOffering    @relation(fields: [offeringId], references: [id])
  scores   AssessmentScore[]

  @@unique([studentId, offeringId])
  /// Target of the composite FK guaranteeing a score's criterion belongs to the same offering.
  @@unique([id, offeringId])
  @@index([offeringId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------------------------
// Criteria & grading
// ---------------------------------------------------------------------------------------------

enum CriterionCategory {
  QUIZ
  EXAM
  HOMEWORK
  ASSIGNMENT
  PROJECT
  PRESENTATION
  PARTICIPATION
  OTHER
}

model AssessmentCriterion {
  id             String            @id @default(uuid(7)) @db.Uuid
  offeringId     String            @map("offering_id") @db.Uuid
  /// Stable identifier (e.g. Q1). Never changes; renames change `name` only.
  key            String            @db.Citext
  name           String
  category       CriterionCategory @default(OTHER)
  displayOrder   Int               @map("display_order")
  isActive       Boolean           @default(true) @map("is_active")
  description    String?
  /// Column key in the sheet when it differs from `key`.
  sheetColumnKey String?           @map("sheet_column_key") @db.Citext
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  offering       CourseOffering       @relation(fields: [offeringId], references: [id])
  schemeItems    GradingSchemeItem[]
  scores         AssessmentScore[]
  columnMappings SheetColumnMapping[]

  @@unique([offeringId, key])
  @@unique([offeringId, sheetColumnKey])
  @@unique([id, offeringId])
  @@map("assessment_criteria")
}

enum SchemeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SchemeOrigin {
  SHEET
  ADMIN
}

model GradingScheme {
  id            String       @id @default(uuid(7)) @db.Uuid
  offeringId    String       @map("offering_id") @db.Uuid
  version       Int
  status        SchemeStatus @default(DRAFT)
  origin        SchemeOrigin
  totalWeight   Decimal      @default(0) @map("total_weight") @db.Decimal(7, 3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  publishedById String?      @map("published_by") @db.Uuid
  /// NULL when created by sync.
  createdById   String?      @map("created_by") @db.Uuid
  syncJobId     String?      @map("sync_job_id") @db.Uuid
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  offering    CourseOffering      @relation(fields: [offeringId], references: [id])
  publishedBy User?               @relation("SchemePublishedBy", fields: [publishedById], references: [id])
  createdBy   User?               @relation("SchemeCreatedBy", fields: [createdById], references: [id])
  items       GradingSchemeItem[]

  @@unique([offeringId, version])
  @@unique([id, offeringId])
  @@unique([offeringId], map: "grading_schemes_one_published", where: raw("status = 'PUBLISHED'"))
  @@unique([offeringId], map: "grading_schemes_one_draft", where: raw("status = 'DRAFT'"))
  @@map("grading_schemes")
}

/// Max mark and weight per criterion for one scheme version (a.k.a. criterion_weights).
model GradingSchemeItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  schemeId    String  @map("scheme_id") @db.Uuid
  /// Denormalized so composite FKs force scheme and criterion to share one offering.
  offeringId  String  @map("offering_id") @db.Uuid
  criterionId String  @map("criterion_id") @db.Uuid
  maxMark     Decimal @map("max_mark") @db.Decimal(8, 3)
  weight      Decimal @db.Decimal(6, 3)

  scheme    GradingScheme       @relation(fields: [schemeId, offeringId], references: [id, offeringId], onDelete: Cascade)
  criterion AssessmentCriterion @relation(fields: [criterionId, offeringId], references: [id, offeringId])

  @@unique([schemeId, criterionId])
  @@index([criterionId])
  @@map("grading_scheme_items")
}

/// Letter grades for one generation. Students see letters only once `confirmed`.
model GradeScale {
  id            String    @id @default(uuid(7)) @db.Uuid
  generationId  String    @unique @map("generation_id") @db.Uuid
  confirmed     Boolean   @default(false)
  confirmedById String?   @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  generation  Generation  @relation(fields: [generationId], references: [id])
  confirmedBy User?       @relation(fields: [confirmedById], references: [id])
  bands       GradeBand[]

  @@map("grade_scales")
}

/// A total ≥ min_total (and below the next band) earns `letter`.
model GradeBand {
  id       String  @id @default(uuid(7)) @db.Uuid
  scaleId  String  @map("scale_id") @db.Uuid
  letter   String
  minTotal Decimal @map("min_total") @db.Decimal(5, 2)
  isPass   Boolean @map("is_pass")

  scale GradeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, letter])
  @@unique([scaleId, minTotal])
  @@map("grade_bands")
}

// ---------------------------------------------------------------------------------------------
// Scores
// ---------------------------------------------------------------------------------------------

enum ScoreStatus {
  RECORDED
  /// Explicit zero ("ABS" in the sheet).
  ABSENT
  /// Erased in the sheet: counts as not entered. `mark` keeps the last value for the history.
  CLEARED
}

/// A missing mark is the absence of a row, never a zero.
model AssessmentScore {
  id           String      @id @default(uuid(7)) @db.Uuid
  enrollmentId String      @map("enrollment_id") @db.Uuid
  /// Denormalized so composite FKs force enrollment and criterion to share one offering.
  offeringId   String      @map("offering_id") @db.Uuid
  criterionId  String      @map("criterion_id") @db.Uuid
  status       ScoreStatus
  mark         Decimal     @db.Decimal(8, 3)
  sourceId     String?     @map("source_id") @db.Uuid
  sourceTab    String?     @map("source_tab")
  sourceRow    Int?        @map("source_row")
  /// Last sync job that changed the value.
  syncJobId    String?     @map("sync_job_id") @db.Uuid
  /// Admin who made a manual correction.
  updatedById  String?     @map("updated_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment Enrollment                @relation(fields: [enrollmentId, offeringId], references: [id, offeringId])
  criterion  AssessmentCriterion       @relation(fields: [criterionId, offeringId], references: [id, offeringId])
  updatedBy  User?                     @relation(fields: [updatedById], references: [id])
  revisions  AssessmentScoreRevision[]

  @@unique([enrollmentId, criterionId])
  @@index([criterionId])
  @@map("assessment_scores")
}

/// Append-only history of score changes.
model AssessmentScoreRevision {
  id          String       @id @default(uuid(7)) @db.Uuid
  scoreId     String       @map("score_id") @db.Uuid
  oldStatus   ScoreStatus? @map("old_status")
  oldMark     Decimal?     @map("old_mark") @db.Decimal(8, 3)
  newStatus   ScoreStatus  @map("new_status")
  newMark     Decimal      @map("new_mark") @db.Decimal(8, 3)
  syncJobId   String?      @map("sync_job_id") @db.Uuid
  changedById String?      @map("changed_by") @db.Uuid
  sourceTab   String?      @map("source_tab")
  sourceRow   Int?         @map("source_row")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  score     AssessmentScore @relation(fields: [scoreId], references: [id])
  changedBy User?           @relation(fields: [changedById], references: [id])

  @@index([scoreId, createdAt])
  @@map("assessment_score_revisions")
}

// ---------------------------------------------------------------------------------------------
// Synchronization
// ---------------------------------------------------------------------------------------------

enum SyncScope {
  SOURCE
  GENERATION
  ALL
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_ERRORS
  FAILED
  CANCELLED
}

model SyncJob {
  id               String     @id @default(uuid(7)) @db.Uuid
  parentId         String?    @map("parent_id") @db.Uuid
  scope            SyncScope
  sourceId         String?    @map("source_id") @db.Uuid
  /// Scope SOURCE: the term of its source, for the one-running-sync-per-term rule.
  termId           String?    @map("term_id") @db.Uuid
  generationId     String?    @map("generation_id") @db.Uuid
  status           SyncStatus @default(QUEUED)
  phase            String?
  progressCurrent  Int        @default(0) @map("progress_current")
  progressTotal    Int        @default(0) @map("progress_total")
  /// Report summary: per-entity created/updated/unchanged/skipped/rejected counts.
  counts           Json       @default("{}")
  errorCount       Int        @default(0) @map("error_count")
  warningCount     Int        @default(0) @map("warning_count")
  failureCode      String?    @map("failure_code")
  failureMessage   String?    @map("failure_message")
  retryOfId        String?    @map("retry_of_id") @db.Uuid
  /// Scope ALL only: restricts the run to this term number in every active generation.
  termNumber       Int?       @map("term_number") @db.SmallInt
  /// { tabMappingId: version } of the mappings this job applied.
  mappingVersions  Json?      @map("mapping_versions")
  /// The confirmed preview this job applies. Only a job with one can archive subjects.
  previewId        String?    @map("preview_id") @db.Uuid
  /// The admin ticked "Release scores after sync": a successful run releases the term.
  releaseAfterSync Boolean    @default(false) @map("release_after_sync")
  /// Run lease: the worker currently executing the job. A second delivery of the same job
  /// cannot claim it until the lease is released or expires (crashed worker).
  leaseToken       String?    @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?  @map("lease_expires_at") @db.Timestamptz(3)
  requestedById    String     @map("requested_by") @db.Uuid
  queuedAt         DateTime   @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt        DateTime?  @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?  @map("finished_at") @db.Timestamptz(3)

  parent      SyncJob?           @relation("SyncJobChildren", fields: [parentId], references: [id])
  children    SyncJob[]          @relation("SyncJobChildren")
  retryOf     SyncJob?           @relation("SyncJobRetries", fields: [retryOfId], references: [id])
  retries     SyncJob[]          @relation("SyncJobRetries")
  source      GoogleSheetSource? @relation(fields: [sourceId], references: [id])
  term        Term?              @relation(fields: [termId], references: [id])
  generation  Generation?        @relation(fields: [generationId], references: [id])
  requestedBy User               @relation(fields: [requestedById], references: [id])
  errors      SyncError[]

  @@unique([sourceId], map: "sync_jobs_one_active_per_source", where: raw("scope = 'SOURCE' AND finished_at IS NULL"))
  @@unique([termId], map: "sync_jobs_one_active_per_term", where: raw("scope = 'SOURCE' AND finished_at IS NULL"))
  @@index([sourceId, queuedAt(sort: Desc)])
  @@index([parentId])
  @@index([status])
  @@index([queuedAt(sort: Desc)])
  @@map("sync_jobs")
}

enum SyncErrorSeverity {
  ERROR
  WARNING
}

model SyncError {
  id           String            @id @default(uuid(7)) @db.Uuid
  jobId        String            @map("job_id") @db.Uuid
  severity     SyncErrorSeverity
  code         String
  message      String
  sheetTab     String?           @map("sheet_tab")
  rowNumber    Int?              @map("row_number")
  columnKey    String?           @map("column_key")
  studentCode  String?           @map("student_code")
  courseKey    String?           @map("course_key")
  criterionKey String?           @map("criterion_key")
  /// Truncated to 200 characters by the writer.
  rawValue     String?           @map("raw_value")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  job SyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, severity])
  @@map("sync_errors")
}

// ---------------------------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------------------------

enum ActorType {
  USER
  SYSTEM
}

/// Append-only (UPDATE/DELETE rejected by trigger).
model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  /// Dotted action name, e.g. auth.login.success
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    Json      @default("{}")
  ip          String?
  userAgent   String?   @map("user_agent")
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
