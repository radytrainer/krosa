{
  "name": "@ssrs/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "11.6.0",
    "decimal.js": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ssrs/config": "workspace:*",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.9",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "dotenv": ">=16"
  },
  "peerDependenciesMeta": {
    "dotenv": {
      "optional": true
    }
  }
}
