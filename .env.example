# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
LOG_LEVEL=info

# --- Local infrastructure (docker-compose.yml) -------------------------------------------
POSTGRES_DB=ssrs
POSTGRES_USER=ssrs
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- Database roles (docs/database-design.md "Roles") ----------------------------------------
# Migrations and maintenance run as the database OWNER (POSTGRES_USER). The api and worker connect
# as the restricted application role <database>_app (data access only, no DDL). The migration
# 20261118120000_app_role creates the role; `pnpm db:app-role`, run through scripts/db-guard.sh,
# then gives it LOGIN and this password (docs/database-design.md "Roles"; generate it like the
# others: letters and digits only, it goes inside a URL). Until the migration is applied to ssrs
# (explicit approval), keep DATABASE_URL on the owner.
DATABASE_MIGRATION_URL=postgresql://ssrs:change-me-postgres@localhost:5432/ssrs
APP_DB_PASSWORD=change-me-app-role

# --- Shared by api and worker -------------------------------------------------------------
# The application role, not the owner.
DATABASE_URL=postgresql://ssrs_app:change-me-app-role@localhost:5432/ssrs
REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- API ----------------------------------------------------------------------------------
API_PORT=4000
# Public origin of the web app; used for Origin/CSRF checks and cookie settings.
WEB_ORIGIN=http://localhost:3000
# Reverse-proxy hops to trust for client IP addresses (1 behind Caddy, 0 locally).
TRUST_PROXY_HOPS=0
# Swagger UI at /api/docs. Keep false in production unless access is restricted.
SWAGGER_ENABLED=true
# Signs access tokens and derives CSRF tokens. At least 32 random characters.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
# Must not exceed SESSION_IDLE_TIMEOUT_SECONDS.
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_HOURS=168
# Inactivity logout: a session with no heartbeat for this long ends (min 60).
SESSION_IDLE_TIMEOUT_SECONDS=900
# How often a visible tab sends a heartbeat (min 10, at most a third of the idle timeout).
SESSION_HEARTBEAT_INTERVAL_SECONDS=300
# Open live connections (GET /api/v1/auth/live) allowed per session and per user.
LIVE_MAX_PER_SESSION=3
LIVE_MAX_PER_USER=5
# Temporary passwords issued by admins expire after this many days.
TEMP_PASSWORD_TTL_DAYS=14
# Defaults to true when WEB_ORIGIN is https; must be true in production.
# COOKIE_SECURE=true
# Global request budget per client IP per minute (docs/security.md §7). Raise only for load tests.
RATE_LIMIT_PER_MINUTE=300
# Extra origins allowed to call the API with credentials (comma-separated, exact, no "*").
# Leave empty: the web app is served from the same origin.
# CORS_ORIGINS=

# --- Error reporting (api and worker) ------------------------------------------------------
# Optional. Unset: Sentry is disabled. Events are scrubbed (no cookies, headers, bodies, users).
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# --- Google Sheets (read-only service account; see docs/google-sheets-template.md §7) -----
# Optional for local development: without credentials, spreadsheet registration and sync return
# GOOGLE_NOT_CONFIGURED. Configure EITHER a mounted JSON key file (preferred) ...
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-sa.json
# ... OR the inline pair (literal \n sequences in the key are converted to newlines):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=ssrs-sync@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Worker -------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
# How often a running worker re-checks for sync jobs orphaned by a crashed worker (ms).
ORPHAN_SWEEP_INTERVAL_MS=300000

# --- Web ----------------------------------------------------------------------------------
# Where the Next.js server proxies /api/* in development.
API_INTERNAL_URL=http://localhost:4000

# --- Tests ----------------------------------------------------------------------------------
# Integration tests wipe these. The database name MUST end in _test (enforced by the helpers);
# Redis DB 15 is reserved for tests.
# The owner (migrations, resets) and the restricted role the code under test uses. The test
# setup creates ssrs_test_app's login with the password given here.
TEST_DATABASE_URL=postgresql://ssrs:change-me-postgres@localhost:5432/ssrs_test
TEST_APP_DATABASE_URL=postgresql://ssrs_test_app:change-me-test-app-role@localhost:5432/ssrs_test
TEST_REDIS_URL=redis://:change-me-redis@localhost:6379/15

# Optional. Passwords for the test admin and student accounts. Leave empty and each test run
# generates strong random ones (apps/api/test/support/credentials.ts, e2e/support/credentials.ts).
TEST_ADMIN_PASSWORD=
TEST_STUDENT_PASSWORD=
