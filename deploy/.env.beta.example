# Settings for the beta server (docs/beta-checklist.md step 14). Template only: NO REAL VALUES here,
# ever. On the server, as root:
#
#   install -m 600 -o root -g root /dev/null /opt/ssrs/.env
#   (paste this template into /opt/ssrs/.env with: sudo nano /opt/ssrs/.env)
#   then fill the four generated secrets with fresh random values, without printing them:
#
#   for v in POSTGRES_PASSWORD APP_DB_PASSWORD REDIS_PASSWORD JWT_ACCESS_SECRET; do
#     sudo sed -i "s|^$v=.*|$v=$(openssl rand -hex 32)|" /opt/ssrs/.env
#   done
#
# Hex only (letters and digits): the passwords go inside connection URLs, where + / = break them.
# Beta secrets are new: never copy a value from a laptop's .env or from any other server.
# Keep a copy of the finished file in the school's password manager, not in the repository.
# Only variables used in deploy/compose.yml reach the containers.

# --- Public address ---------------------------------------------------------------------------
# Host name only, no https:// (e.g. krosa-beta.example.org). Its DNS A record points at the
# Elastic IP. Also sets WEB_ORIGIN=https://<BETA_DOMAIN> for the API (cookies, CSRF Origin check).
BETA_DOMAIN=
# Receives Let's Encrypt certificate expiry notices.
ACME_EMAIL=

# --- Images -----------------------------------------------------------------------------------
# GHCR prefix, lower case: ghcr.io/<owner>/<repo> (e.g. ghcr.io/radytrainer/krosa). The deploy adds
# -api, -worker, -web and the commit sha. Not a secret.
IMAGE_PREFIX=

# --- Database and Redis (internal Docker network only, never published) ----------------------
POSTGRES_DB=ssrs
POSTGRES_USER=ssrs
# Secret: openssl rand -hex 32 (see the loop above). The database OWNER: used only by migrations,
# backups and restores.
POSTGRES_PASSWORD=
# Secret: openssl rand -hex 32. The restricted role the api and worker connect as (`<POSTGRES_DB>_app`,
# e.g. ssrs_app: data access only, no DDL). Every deploy sets it on the role (deploy.sh step 3).
APP_DB_PASSWORD=
# Secret: openssl rand -hex 32.
REDIS_PASSWORD=

# --- Sessions ---------------------------------------------------------------------------------
# Secret: openssl rand -hex 32 (at least 32 characters). Signs access tokens AND derives the CSRF
# key (there is no separate CSRF secret). Refresh tokens are random and stored hashed, so there
# is no refresh secret either. Changing it signs everyone out.
JWT_ACCESS_SECRET=
# Access-token lifetime, seconds (API and worker). Must not exceed SESSION_IDLE_TIMEOUT_SECONDS.
ACCESS_TOKEN_TTL_SECONDS=900
# Inactivity logout, seconds (min 60). docs/decisions.md SR2.
SESSION_IDLE_TIMEOUT_SECONDS=900
# Heartbeat from a visible tab, seconds (min 10, at most a third of the idle timeout).
SESSION_HEARTBEAT_INTERVAL_SECONDS=300
# Open live connections allowed per session / per user (extra: 429).
LIVE_MAX_PER_SESSION=3
LIVE_MAX_PER_USER=5
# Lifetime of admin-issued temporary passwords, days.
TEMP_PASSWORD_TTL_DAYS=14
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=300

# --- Google Sheets service account -----------------------------------------------------------
# Path of the JSON key ON THE SERVER. Mounted read-only into api and worker; never in an image.
# The file must be owner root, group SECRETS_GID, mode 0440 (docs/beta-checklist.md step 15).
GOOGLE_SA_FILE=/opt/ssrs/secrets/google-sa.json
# Group that may read the key; created by bootstrap.sh (ssrs-secrets). Containers join it.
SECRETS_GID=2000

# --- Worker -----------------------------------------------------------------------------------
# Syncs at the same time. 1 fits a 1 GB server.
WORKER_CONCURRENCY=1
# api and worker log level: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# --- Error reporting (Sentry) -----------------------------------------------------------------
# DSN of the Sentry project for api and worker. Empty: Sentry off. Treat as a secret.
SENTRY_DSN=
SENTRY_ENVIRONMENT=beta

# --- Backups (scripts/server/backup.sh) -------------------------------------------------------
# Bucket from the CloudFormation stack (output BackupBucketName) and its prefix (BackupPrefix).
BACKUP_BUCKET=
BACKUP_PREFIX=beta
# Region of the bucket (the beta runs in Sydney).
AWS_REGION=ap-southeast-2
# Optional dead-man alerts (healthchecks.io). Ping URLs are secrets: anyone with one can mark the
# check as healthy. Leave empty to disable.
HEALTHCHECKS_BACKUP_URL=
HEALTHCHECKS_DISK_URL=
# Disk use above this percentage fails the disk check (scripts/server/check-disk.sh).
DISK_WARN_PERCENT=80
