# Reverse proxy and TLS for the beta server (docs/deployment.md). SITE_ADDRESS is BETA_DOMAIN from
# /opt/ssrs/.env; Caddy obtains and renews its certificate automatically (Let's Encrypt) and
# redirects HTTP to HTTPS.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	# The live session stream (GET /api/v1/auth/live, server-sent events) is never compressed,
	# so each event reaches the browser at once.
	@compressible not path /api/v1/auth/live
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	# Public uptime check for an external monitor: "OK" when the API, PostgreSQL and Redis are up,
	# 503 otherwise. Says nothing else (no versions, no latencies, no data).
	handle /health {
		rewrite * /api/v1/health/ready
		reverse_proxy api:4000 {
			@ready status 2xx
			handle_response @ready {
				header Cache-Control "no-store"
				respond "OK" 200
			}
			handle_response {
				header Cache-Control "no-store"
				respond "UNAVAILABLE" 503
			}
		}
	}

	# The API's own health routes report per-dependency latencies and are not rate limited: they
	# stay inside Docker (container health checks call them directly). /health above is public.
	handle /api/v1/health* {
		respond 404
	}

	# The API serves /api/v1/*; Swagger stays off in production (SWAGGER_ENABLED=false).
	handle /api/* {
		reverse_proxy api:4000 {
			# Streams (text/event-stream) are flushed immediately; this keeps every response unbuffered.
			flush_interval -1
			header_up X-Request-Id {http.request.uuid}
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
