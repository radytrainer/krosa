# Production settings for docker-compose.prod.yml (docs/deployment.md §6 and §8).
# Copy to .env.production on the server, replace every placeholder, then: chmod 600 .env.production
# Never commit .env.production.
#
# Generate each secret with:  openssl rand -hex 32
# Use hex (letters and digits only): the passwords go inside connection URLs, where +, / and =
# would break them.

# --- Public address -----------------------------------------------------------------------
# Host name only, no https:// (the DNS A record must point at the server's Elastic IP).
SITE_ADDRESS=krosa.example.org
# Receives certificate expiry notices from Let's Encrypt.
ACME_EMAIL=it-admin@example.org

# --- Database and Redis (internal network only, never published) ---------------------------
POSTGRES_DB=ssrs
POSTGRES_USER=ssrs
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_PASSWORD=replace-with-openssl-rand-hex-32

# --- Sessions -------------------------------------------------------------------------------
# At least 32 random characters. Changing it signs everyone out.
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32

# --- Google Sheets service account -----------------------------------------------------------
# Path of the JSON key on the server (chmod 600). Mounted into api and worker as a secret.
GOOGLE_SA_FILE=./secrets/google-sa.json

# --- Optional (defaults shown) ---------------------------------------------------------------
LOG_LEVEL=info
TEMP_PASSWORD_TTL_DAYS=14
RATE_LIMIT_PER_MINUTE=300
WORKER_CONCURRENCY=2

# Nightly database backups (UTC time, days kept, folder on the server).
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups

# Error reporting. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Prebuilt images: with CI/CD (docs/deployment.md §8.6) IMAGE_PREFIX and IMAGE_TAG live in
# .env.deploy, which scripts/deploy.sh updates on every release. Leave them out of this file.
