{
  "name": "student-score-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings apps/api apps/worker packages && pnpm --filter @ssrs/web lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ssrs/database generate",
    "db:migrate": "pnpm --filter @ssrs/database migrate:dev",
    "db:deploy": "pnpm --filter @ssrs/database migrate:deploy",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "test:integration": "turbo run test:integration --concurrency=1",
    "admin:create": "pnpm --filter @ssrs/api admin:create",
    "demo:seed": "pnpm --filter @ssrs/api demo:seed",
    "test:e2e": "pnpm --filter @ssrs/e2e test:e2e"
  },
  "devDependencies": {
    "autocannon": "8.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
